{
  "name": "tbep",
  "main": "src/main.py",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "python_workers"
  ],
  "python_modules": {
    "excludes": [
      "**/*.pyc",
      "**/__pycache__/**"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
